<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="12dp">

    <!-- Time -->
    <TextView
        android:id="@+id/tvTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textSize="11sp"
        android:textColor="@color/text_secondary"
        android:fontFamily="monospace"
        android:layout_marginBottom="4dp" />

    <!-- Package -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="2dp">
        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
            android:text="Package:" android:textSize="11sp" android:textColor="@color/text_secondary" />
        <TextView android:id="@+id/tvPackage" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="11sp" android:textColor="@color/text_primary"
            android:fontFamily="monospace" />
    </LinearLayout>

    <!-- App Name -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="4dp">
        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
            android:text="App:" android:textSize="11sp" android:textColor="@color/text_secondary" />
        <TextView android:id="@+id/tvApp" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="11sp" android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Title -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="2dp">
        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
            android:text="Title:" android:textSize="12sp" android:textColor="@color/text_secondary" />
        <TextView android:id="@+id/tvTitle" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="13sp" android:textColor="@color/text_primary"
            android:textStyle="bold" />
    </LinearLayout>

    <!-- Text -->
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="2dp">
        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
            android:text="Text:" android:textSize="12sp" android:textColor="@color/text_secondary" />
        <TextView android:id="@+id/tvText" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="12sp" android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- BigText (ซ่อนถ้าไม่มี) -->
    <LinearLayout android:id="@+id/rowBig" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:layout_marginBottom="2dp" android:visibility="gone">
        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
            android:text="BigText:" android:textSize="12sp" android:textColor="@color/text_secondary" />
        <TextView android:id="@+id/tvBig" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="12sp" android:textColor="@color/text_primary" />
    </LinearLayout>

    <!-- SubText (ซ่อนถ้าไม่มี) -->
    <LinearLayout android:id="@+id/rowSub" android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="horizontal" android:visibility="gone">
        <TextView android:layout_width="80dp" android:layout_height="wrap_content"
            android:text="SubText:" android:textSize="12sp" android:textColor="@color/text_secondary" />
        <TextView android:id="@+id/tvSub" android:layout_width="0dp" android:layout_height="wrap_content"
            android:layout_weight="1" android:textSize="12sp" android:textColor="@color/text_primary" />
    </LinearLayout>

</LinearLayout>
